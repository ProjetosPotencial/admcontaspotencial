+    ["CNPJ", cnpj],
+    ["Nº da nota", item.numero_documento_detectado ?? "—"],
+    ["Valor", item.valor_detectado != null ? money(item.valor_detectado) : "—"],
+    ["Emissão", emissao],
+    ["Categoria", item.tipo_detectado ? (TIPOS[item.tipo_detectado]?.n ?? item.tipo_detectado) : "—"],
+  ];
+
+  return (
+    <div className="card p-4">
